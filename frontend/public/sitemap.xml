<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static sitemap for Phishion.

  This file is served straight from /public, so it cannot interpolate
  NEXT_PUBLIC_SITE_URL at request time. Every <loc> below uses the same default
  as that env var (http://localhost:3000). Before deploying, replace the host in
  each <loc> with the production origin you set in NEXT_PUBLIC_SITE_URL.

  This list is maintained by hand. Regenerate it whenever routes are added,
  removed or renamed. Account-sensitive and non-indexable routes are excluded on
  purpose: /settings, /delete, /profile, /logout, /result, /components.
-->
