# Copy to .env and fill in. .env is gitignored; never commit real values.
#
#   cp .env.example .env
#
# Docker Compose reads this file automatically from the repository root.

# --- Required by Compose (the db service and the backend) ---------------------
POSTGRES_USER=phishion
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phishion_db

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- Required by the backend --------------------------------------------------
VIRUSTOTAL_API_KEY=change-me
SECURITYTRAILS_API_KEY=change-me

# --- Running the backend natively (not needed for Compose) -------------------
# Compose builds DATABASE_URL itself from the POSTGRES_* values above and points
# it at the "db" service, so you do not need to set it for `docker compose up`.
# It is only read when you run Flask directly on the host, where the hostname
# "db" does not resolve.
#
# The db service is deliberately not published to the host, so a native backend
# cannot reach the Compose Postgres. Use SQLite for native development:
#
#   DATABASE_URL=sqlite:////absolute/path/to/phishion/phishion_dev.db
#
# DATABASE_URL=

# --- Optional ----------------------------------------------------------------
# FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_BACKEND_NAME=api
# Public origin used for canonical, og:url and og:image. Baked into the client
# bundle at build time, so set it before `docker compose build`.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# FRONTEND_PORT=3000
# BACKEND_PORT=4000
# Set true when serving over HTTPS.
# SESSION_COOKIE_SECURE=false
# DAILY_SCAN_LIMIT=5
# MAX_BATCH_SIZE=10
# EXTERNAL_HTTP_TIMEOUT=15
# CACHE_TTL_SECONDS=300
# Optional shared cache. Required if you run more than one backend replica.
# REDIS_URL=
